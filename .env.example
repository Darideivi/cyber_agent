# Copy this file to .env for local `vercel dev` / Flask runs of the web app.
# .env is gitignored — it will never be committed.
# In production these are set as Vercel Project Environment Variables instead.

OPENAI_API_KEY=sk-...

# Password required to run a live /investigate — keeps the public demo from
# burning your OpenAI balance. The demo runs real OpenAI calls against a
# bundled synthetic dataset (DEMO_DATA.py), not live Azure Log Analytics,
# so no Azure credentials are needed here.
INVESTIGATE_PASSWORD=choose-a-password

# Auto-populated by Vercel when you attach a Vercel Postgres database to the
# project. Set it manually here for local dev against that same database.
POSTGRES_URL=postgres://...
